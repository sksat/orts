{
  "name": "orts-viewer",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sksat/orts",
    "directory": "viewer"
  },
  "type": "module",
  "exports": {
    "./lib": "./src/lib/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm:arika": "wasm-pack build ../arika/wasm --target web --out-dir pkg-build --out-name arika -- --locked && cp ../arika/wasm/pkg-build/arika.js ../arika/wasm/pkg-build/arika_bg.wasm ../arika/wasm/pkg-build/arika.d.ts ../arika/wasm/pkg-build/arika_bg.wasm.d.ts ../arika/wasm/pkg/",
    "build:wasm:rrd": "wasm-pack build ../rrd-wasm --target web --out-dir ../viewer/src/wasm/rrd-wasm --out-name rrd_wasm -- --locked --features wasm",
    "build:wasm": "pnpm run build:wasm:arika && pnpm run build:wasm:rrd",
    "build": "pnpm run build:wasm && tsc && vite build",
    "build:lib": "pnpm run build:wasm:arika && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "registry:gen": "node scripts/gen-registry.mjs",
    "registry:build": "pnpm run registry:gen && pnpm dlx shadcn@4.11.0 build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "exports": {
      "./lib": {
        "types": "./dist-lib/lib/index.d.ts",
        "import": "./dist-lib/lib/index.js"
      }
    }
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "arika-wasm": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.176.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@playwright/test": "^1.58.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sksat/uneri": "workspace:*",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "arika-wasm": "workspace:*",
    "happy-dom": "^20.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-license": "^3.7.1",
    "three": "^0.183.0",
    "typescript": "^5.7.0",
    "uplot": "^1.6.32",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "ws": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
