// Phase P1: orts 宇宙機プラグインインターフェース v1
//
// orts シミュレータと外部の宇宙機制御プラグイン間の長期的な API 契約。
// Phase P1 では B-dot デタンブリングコントローラを WASM Component
// ゲストで動かすのに必要な最小の型とエントリーポイントのみを定義。
// 後続フェーズで `host-env`（大気密度、太陽方向等）と `command`
// （スラスタ、impulsive dv 等）を追加拡張する。
//
// ## バージョニング
//
// この world は `wit/v0/` 以下に配置。record フィールド、enum variant、
// import/export 関数シグネチャの破壊的変更は `wit/v1/` への移行が必要。
// 追加的変更（新しい host-env 関数、デフォルト付き新 command variant）
// は既存ゲストを壊さない範囲でこのファイル内で行える。
//
// ## WIT world に反映しないホスト側メソッド
//
// ホスト側 `PluginController` trait の以下のメソッドは WIT には含めない:
//
// - `api_version`: WIT パッケージバージョン (`orts:plugin@0.1.0`) で
//   カバー。ホストはロード時に component の WIT メタデータを読んで
//   バージョン不一致を検出する。
// - `snapshot_state` / `restore_state`: Phase P6 ホットリロード用。
//   非破壊的な追加拡張として別 interface で追加するか、`wit/v1/` で対応。
//
// ## 命名規則
//
// - 座標系: `eci` (Earth-centred inertial, SimpleEci or Gcrs), `ecef`, `body`
// - 単位は doc comment に記載。フィールド名接尾辞は `-km`, `-kms`,
//   `-kgm3` 等のリーフスカラーのみ。`-t` (Tesla) は "time" と衝突
//   するため避ける。
// - クォータニオンは Hamilton、スカラー先頭 `(w, x, y, z)`。

package orts:plugin@0.1.0;

/// ホストとゲスト間で交換する物理量プリミティブ。
///
/// 全てのベクトル / クォータニオン / 状態型は orts の規約に従う:
/// 軌道状態は km / km/s、姿勢は rad / rad/s、磁気モーメントは
/// A·m²、Hamilton クォータニオン (スカラー先頭)、ECI 基準。
interface types {
    /// 3 成分実数ベクトル（汎用、フレーム未指定）。
    record vec3 {
        x: f64,
        y: f64,
        z: f64,
    }

    /// Hamilton クォータニオン、スカラー先頭 `(w, x, y, z)`。
    record quat {
        w: f64,
        x: f64,
        y: f64,
        z: f64,
    }

    /// ECI 座標系での位置 \[km\]。
    ///
    /// v0 の ECI は simple-ECI (歳差・章動・極運動を無視した近似 ECI)。
    /// この interface の ECI 表記は全てこのフレームを指す。
    record position-eci-km {
        x: f64, y: f64, z: f64,
    }

    /// ECI 座標系での速度 \[km/s\]。
    record velocity-eci-kms {
        x: f64, y: f64, z: f64,
    }

    /// ECI 座標系での軌道状態。
    record orbital-state {
        position: position-eci-km,
        velocity: velocity-eci-kms,
    }

    /// 剛体姿勢: 姿勢クォータニオン (body→inertial) と
    /// 機体座標系での角速度 \[rad/s\]。
    ///
    /// inertial は attitude-body-to-inertial と同じく simple-ECI 固定。
    record attitude-state {
        orientation: quat,
        angular-velocity: vec3,
    }

    /// サンプル tick ごとにプラグインコントローラに渡される宇宙機状態。
    /// ホスト側 `orts::SpacecraftState` と対応。
    record spacecraft-state {
        orbit: orbital-state,
        attitude: attitude-state,
        /// 宇宙機質量 \[kg\]。
        mass: f64,
    }

    /// 天文暦元 (UTC)。Julian Date (JD) として直接シリアライズ。
    /// `arika::epoch::Epoch<Utc>` の JD 値と bit-for-bit 対応。
    ///
    /// タイムスケールは **UTC** 固定。ゲストが TDB (天体暦表用) や
    /// TT (歳差・章動用) を必要とする場合は、ホスト側の scale 変換を
    /// 経由するか、`(jd - 2451545.0) * 86400` で UTC 秒を得てから
    /// ゲスト内で近似変換すること。
    record epoch {
        julian-date: f64,
    }

    /// tick 時点で評価されたセンサ読み値。
    ///
    /// ホスト側センサモデル (`orts::sensor`) による事前計算結果。
    /// 各フィールドは `list` — 空リストはそのセンサが未搭載。
    /// index 順序は config 定義順で安定し、シミュレーション中に変わらない。
    ///
    /// ## バージョニング
    /// 0.x / v0: repo 内 host/guest lockstep。breaking change 可。
    /// 変更時は全 example plugin bindings と oracle tests を同時更新。
    /// v1: third-party plugin 向け安定 ABI。record field 変更禁止。

    /// 機体座標系の磁場 \[T\]。
    record magnetic-field-body {
        x: f64, y: f64, z: f64,
    }

    /// 機体座標系の角速度 \[rad/s\]。
    record angular-velocity-body {
        x: f64, y: f64, z: f64,
    }

    /// 姿勢クォータニオン body→inertial (Hamilton scalar-first)。
    ///
    /// inertial は simple-ECI (position-eci-km と同じ、v0 の ECI)。
    /// クォータニオンの成分は基準フレームに依存するので、v0 はこの
    /// フレームを contract として固定している (host 側は型で強制: 他の inertial
    /// frame の姿勢を guest に渡すのは compile error)。他フレームを扱うなら
    /// payload に frame を明記する新しい WIT version が必要。
    record attitude-body-to-inertial {
        w: f64, x: f64, y: f64, z: f64,
    }

    /// ������座標系での太陽方向（単位ベクトル、satellite→Sun）。
    record sun-direction-body {
        x: f64, y: f64, z: f64,
    }

    /// Fine sun sensor 出力: 方向 + 照度。
    record sun-fine-output {
        /// 太陽方向 body frame (unit vector, satellite→Sun)。
        /// 本影 (total eclipse, illumination = 0) 中は none。
        /// 半影 (penumbra) 中は太陽中心方向を返す (方向バイアス未モデル化)。
        direction: option<sun-direction-body>,
        /// 照度 \[0, 1\]。1 = full sun, 0 = full eclipse。
        illumination: f64,
    }

    /// Sun sensor 出力。センサタイプにより出力形式が異なる。
    variant sun-sensor-output {
        /// Fine sun sensor: 太陽方向 + 照度。
        fine(sun-fine-output),
        /// Coarse sun sensor (CSS): cos(入射角) × 照度 ��スカラー。
        /// TODO: coarse 実装は将来追加予定。
        coarse(f64),
    }

    /// tick 時点で評価されたセンサ読み値。
    /// フィールド名 = センサ名（複数形）、型 = 物理量 + 座標系。
    record sensors {
        /// 磁力計。任意位置/エポックの磁場が必要なら
        /// `host-env.magnetic-field-eci` を使う。
        magnetometers: list<magnetic-field-body>,

        /// ジャイロスコープ。
        gyroscopes: list<angular-velocity-body>,

        /// スタ��トラッカ。
        star-trackers: list<attitude-body-to-inertial>,

        /// 太陽センサ。
        sun-sensors: list<sun-sensor-output>,
    }

    /// RW テレメトリ（ホイール内部状態のフィードバック）。
    record rw-telemetry {
        /// 各ホイールの角運動量 \[N·m·s\]。
        momentum: list<f64>,
        /// 各ホイールのスピン速度 \[rad/s\]。
        speeds: list<f64>,
        /// 各ホイールの実現トルク \[N·m\]（モータ遅れモデル使用時）。
        realized-torques: option<list<f64>>,
    }

    /// アクチュエータテレメトリ（per-device 構造化フィードバック）。
    record actuator-telemetry {
        /// RW テレメトリ。`none` = RW 未搭載。
        rw: option<rw-telemetry>,
    }

    /// `controller.update` に渡される tick ごとの入力。
    /// ホスト側 `orts::plugin::TickInput<'a>` と対応。
    record tick-input {
        /// シミュレーション時刻 \[s\]、コントローラの t=0 からの経過秒。
        t: f64,
        /// 宇宙機の真値状態（デバッグ・ログ用）。
        spacecraft: spacecraft-state,
        /// 暦元（暦表・磁場モデル等で必要な場合）。
        epoch: option<epoch>,
        /// センサ読み値。将来ノイズが乗る可能性がある。
        sensors: sensors,
        /// アクチュエータテレメトリ。
        actuators: actuator-telemetry,
    }

    /// Per-wheel RW command. The mode (speed vs torque) is per-assembly.
    variant rw-command {
        /// Per-wheel target speed \[rad/s\]. Host motor model generates torque.
        speeds(list<f64>),
        /// Per-wheel motor torque \[N·m\]. Applied directly after clamp.
        torques(list<f64>),
    }

    /// Per-MTQ command. The mode (moments vs normalized) is per-assembly.
    variant mtq-command {
        /// Per-MTQ magnetic dipole moment \[A·m²\] (direct physical quantity).
        moments(list<f64>),
        /// Per-MTQ normalized moment \[-1, 1\].
        /// Realized moment = normalized × max_moment.
        normalized-moments(list<f64>),
    }

    /// Per-thruster command. Phase P4: throttle only.
    /// 将来 impulsive delta-v 等の variant を追加可能。
    variant thruster-command {
        /// Per-thruster throttle level \[0, 1\].
        /// 0 = off, 1 = full thrust. Host clamps to \[0, 1\].
        throttles(list<f64>),
    }

    /// コントローラが返す per-device アクチュエータ指令。
    ///
    /// 各フィールドは per-device の `list<f64>`。長さはアセンブリの
    /// デバイス数と一致する必要がある。`None` のフィールドは
    /// そのアクチュエータに対するコマンドなし（前回値が ZOH で保持）。
    ///
    /// Phase P1: `mtq` + `rw`
    /// Phase P4: `thruster`
    record command {
        /// per-MTQ コマンド（直接モーメント指令または正規化指令）。
        mtq: option<mtq-command>,

        /// per-wheel RW コマンド（速度指令またはトルク指令）。
        rw: option<rw-command>,

        /// per-thruster コマンド（スロットル指令）。
        thruster: option<thruster-command>,
    }

    /// プラグインメタデータ（起動時情報）。
    /// ホストが `metadata(config)` で一度だけ問い合わせる。config に依存する
    /// 項目も含むので厳密には静的ではなく「起動時に決まる情報」。
    record plugin-metadata {
        /// 希望サンプル周期 \[s\]。ホストはこれを参考に tick 間隔を決める。
        /// 正の有限値でなければならない。
        sample-period-s: f64,
    }

    // ─── ノード間メッセージング (C&T / ISL) ─────────────────────────
    //
    // `tick-io` の `command`（FSW→アクチュエータの制御出力）とは別物。
    // こちらは運用者(地上)↔FSW のコマンド/テレメトリ、および将来の
    // 衛星間通信(ISL)を運ぶ **transport 層**。dumb pipe であり、
    // request-response / ack / fire-and-forget / file-transfer といった
    // interaction model は **アプリ層（payload の中身 + SDK ヘルパ）** に
    // 押し出す。transport は中身の意味を解釈しない。

    /// メッセージの論理型（content-type / 次プロトコル識別子）。
    ///
    /// エンコーディングに依らず常に付く = 「型」。名前空間 + version を
    /// 必須とする規約: 例 `"orts.cmd.set-mode.v1"`, `"mission.adcs.hk.v2"`。
    /// 受信側（FSW / 地上）はこの値で payload の解釈プロトコルを選ぶ。
    type msg-kind = string;

    /// 型付きスカラ値。`payload` の `key-value` 表現で使う。
    variant value {
        boolean(bool),
        integer(s64),
        number(f64),
        text(string),
        bytes(list<u8>),
    }

    /// 名前付き値（key-value の 1 要素）。
    record named-value {
        name: string,
        value: value,
    }

    /// メッセージ本体のエンコーディング。ユースケースで選択する。
    ///
    /// 同一 `msg-kind` では canonical encoding を 1 つに固定する規約
    /// （json / key-value / binary を同じ kind で混在させない）。
    variant payload {
        /// 構造化（スカラは型付き）。viewer/CLI/test から扱いやすい。
        key-value(list<named-value>),
        /// 生バイナリ（CCSDS 等、デコードは受信側 FSW）。
        binary(list<u8>),
        /// JSON テキスト。transport は opaque 文字列として扱う。
        json(string),
    }

    /// ノードアドレス（network 層の論理アドレス）。
    ///
    /// node = **コンポーネントを内包する単位**（衛星 / 地上局）。機内の
    /// コンポーネント（アクチュエータ / センサ / 通信機）は node ではない。
    /// 運用者 C&T = `ground` ↔ `satellite`、ISL = `satellite` ↔ `satellite`。
    /// inter-node は物理的には通信機(transceiver) ↔ 媒体 ↔ 通信機 だが、`msg-io`
    /// はそれを隠して node ↔ node に見せる network 抽象。
    variant node-id {
        /// 地上局 / 運用者。
        ground,
        /// 衛星（ID）。
        satellite(u32),
    }

    /// transport が **受信側へ届ける** 完全なメッセージ。
    ///
    /// `src` はホストが注入する（ゲストは送信時に指定できない＝なりすまし防止）。
    ///
    /// NOTE: 将来、決定論リプレイの全順序 anchor（host 採番 seq）・配送 tick・
    /// dedup 用の origin id といった host 採番メタを足すことはありうるが、
    /// それを読む consumer が現れるまでは入れない（YAGNI）。
    record message {
        /// 送信元。ホストが注入。
        src: node-id,
        /// 宛先。
        dst: node-id,
        /// 論理型（content-type）。
        kind: msg-kind,
        /// 本体。
        payload: payload,
    }

    /// ゲスト（FSW）が **送信する** メッセージ。最小限。
    /// `src` はホストが補完する（`message` になる）。
    record outbound {
        /// 宛先（地上なら `ground`、別衛星なら `satellite(id)`）。
        dst: node-id,
        /// 論理型（content-type）。
        kind: msg-kind,
        /// 本体。
        payload: payload,
    }

    // ─── stream-io（byte-stream 接続 / kble 統合）の型 ──────────────

    /// `stream-io` のローカルストリーム名。FSW は自分の口だけを名前で識別する
    /// （例 `"c2a"` / `"uart0"`）。host が外部 URL の (sat, stream) に対応づけ、
    /// guest は他衛星の stream を指定できない。
    type stream-name = string;

    /// `read` の結果。`no-data`（今 tick はデータ無し・相手は生存）と
    /// `closed`（相手切断）を区別する — 空 `list<u8>` だけでは判別できない。
    ///
    /// NOTE: variant にしているのは、将来 RF/erasure 合成のため `gap` /
    /// `overrun` といったイベントを表現する余地を残すため（v1 では data /
    /// no-data / closed のみ）。
    variant stream-read {
        /// 読めたバイト列（`max` 以下、長さ > 0）。
        data(list<u8>),
        /// この tick の凍結バッファは空（相手は生存）。
        no-data,
        /// 相手（対向 / kble 側）が切断した。以後データは来ない。
        closed,
    }

    /// `read` / `write` の失敗。
    variant stream-error {
        /// その名前の stream は構成されていない。
        unknown-stream,
        /// 送受信いずれかの有界キューが溢れた（`read` / `write` 双方で返りうる）。
        /// byte drop はせず接続/シミュレーションを止める（drop はフレーム破壊を
        /// 隠して解析不能にするため）。
        overrun,
        /// stream は既に閉じている。
        closed,
    }
}

/// ゲストがホストに対して呼び出せるサービス（host import）。
///
/// `update` 呼び出し中にゲストがホスト状態にアクセスする唯一の
/// 合法的な手段。全関数は安価で副作用なし（`log` を除く）であること。
interface host-env {
    use types.{vec3, epoch};

    /// ログレベル。orts 全体で使用する `tracing` crate のレベルと対応。
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// ゲストからログレコードを出力する。
    log: func(level: log-level, message: string);

    /// 指定 ECI 位置・エポックでの地磁気ベクトルを ECI 座標系で返す \[T\]。
    ///
    /// 宇宙機の現在位置・姿勢での機体座標系磁場が欲しい場合は
    /// `sensors.magnetometer` を使う方がオーバーヘッドがない。
    /// このインポートは任意位置/エポックの磁場が必要な場合
    /// （予測・計画等）の "escape hatch"。
    ///
    /// Phase P1 では `tobari::magnetic::TiltedDipole` に接続。
    /// Phase D-5 で IGRF 球面調和モデルへ移行予定。
    magnetic-field-eci: func(
        position-eci-km: vec3,
        e: epoch,
    ) -> vec3;
}

/// ホスト-ゲスト間の tick 通信。
///
/// ゲストは `wait-tick` で中断し、ホストが次の tick で再開する。
/// `send-command` でコマンドをホストに送る。
///
/// 位置づけ: `tick-io` は **tick 結合の control plane**（FSW → アクチュエータ）。
/// ここでの `command` は**アクチュエータ制御出力**で、`msg-io` が運ぶ運用
/// メッセージ (telecommand) とは別物。通信の「形(shape)」ではなく、同期 tick 内の
/// 型付き制御出力である点に注意。
interface tick-io {
    use types.{tick-input, command};

    /// ホストに制御を返し、次の tick まで待つ。
    /// ホスト中断方式: worker thread + blocking channel (サーバ/CLI),
    /// JSPI (ブラウザ)。
    ///
    /// 戻り値が `none` の場合はホストが shutdown を要求していることを示す。
    /// ゲストは `run()` を `Ok(())` で正常終了させること。
    wait-tick: func() -> option<tick-input>;

    /// コマンドをホストに送る。
    /// 1 tick 中に複数回呼んだ場合は最後の値が適用される。
    send-command: func(cmd: command);
}

/// ノード間メッセージング（運用 C&T + 将来の ISL）。
///
/// datagram shape + `node-id` 論理アドレス + host 確定配送（決定論）から成る
/// **network / service 抽象**（単なる byte 配送路ではない）。`tick-io`（制御）
/// とは独立。ゲストは `update` / `run` の tick 内で `recv-batch` で受信箱を
/// drain し、`send-message` で送信する。
///
/// scope（intra / inter-node）や将来のリンク impairment（欠落・遅延）は、この
/// channel が「何に配線されているか」の属性であり host が決める。決定論（host が
/// どの tick で配送を確定するか）は **time model** で、impairment とは別の次元。
///
/// ## 決定論と "frozen inbox"
///
/// ホストは tick 境界で「その tick に配るメッセージ集合」を凍結する。
/// `recv-batch` はその凍結済み列の先頭から最大 `max` 件を pop する。
/// tick の途中に届いた新着は次 tick の受信箱へ回るため、ゲストが
/// `recv-batch` をいつ・何回呼んでも観測は不変（A 意味論）。
/// drain しきらなかった分は次 tick へ持ち越す（backpressure）。
///
/// `tick-input` には載せない。物理 snapshot を純粋に保ち、大量受信
/// （ファイル転送等）でも `max` でゲストがペース制御できるようにするため。
interface msg-io {
    use types.{message, outbound};

    /// 現在 tick の凍結受信箱から最大 `max` 件を取り出す。
    /// 返り値が空なら、この tick の受信箱は空になった。
    recv-batch: func(max: u32) -> list<message>;

    /// メッセージを送信する。append 意味論（`send-command` の
    /// last-write-wins とは異なり、1 tick 内の複数送信は全て保持される）。
    send-message: func(msg: outbound);
}

/// バイトストリーム接続（[`kble`](https://github.com/arkedge/kble) virtual
/// harness 統合 / 将来の RF seam）。orts は中身を解釈しない **dumb byte
/// conduit**。framing（EB90 / C2A / CCSDS / 独自）やプロトコル解釈は FSW 側 +
/// kble pipeline の責務。`msg-io`（orts-native の packet 運用模擬）とは別物の
/// 兄弟として併存し、FSW は deploy で使い分ける。
///
/// `msg-io` と同様、host は tick 境界で受信バッファを凍結し送信を flush する
/// （決定論を保つ）。連続 UART の inter-byte timing や短い timeout 検証は
/// **非目標**（C2A 等フレーム単位プロトコルは許容、PHY/UART 代替ではない）。
///
/// 外部接続は live（`ws://` / stdio で kble と実時間接続・非決定論）と replay
/// （録った byte chunks を tick-stamp して決定論再生・将来）の 2 モードを想定。
interface stream-io {
    use types.{stream-name, stream-read, stream-error};

    /// 名前付き stream の凍結受信バッファから最大 `max` バイトを取り出す。
    /// （`stream` は WIT 予約語のため引数名は `name`。）
    read: func(name: stream-name, max: u32) -> result<stream-read, stream-error>;

    /// 名前付き stream へバイト列を書く（append、次の tick 境界で flush）。
    /// 送信キューが上限を超えると `overrun`（byte drop はしない）。
    write: func(name: stream-name, bytes: list<u8>) -> result<_, stream-error>;
}

/// プラグイン。ゲストがメインループを持ち、ホストは tick-io で駆動する。
///
/// コールバック型（`init` + 毎 tick `update`）のゲストも SDK の
/// `orts_plugin!` マクロが内部的にこの world 向けにラップする。
///
/// ## ライフサイクル
///
/// 1. ホストが `metadata(config)` を呼ぶ。config の早期検証を兼ねる。
///    不正な config はここで `Err` を返すこと。
/// 2. 成功したら、ホストが新しい worker thread で `run(config)` を起動する。
/// 3. ゲストは `run` の中で `wait-tick` → 制御計算 → `send-command` を繰り返す。
/// 4. ホストが shutdown する時は、`wait-tick` が `none` を返すので
///    ゲストは `run` を `Ok(())` で正常終了させる。
///
/// `metadata` と `run` では config が 2 回パースされるが、config は純粋関数的で
/// あるべきで副作用を持たないため実害はない。
world plugin {
    use types.{plugin-metadata};

    import host-env;
    import tick-io;
    import msg-io;
    import stream-io;

    /// メタデータを取得する。config の早期検証を兼ねる。
    /// 不正な config の場合は `Err` を返すこと。
    export metadata: func(config: string) -> result<plugin-metadata, string>;

    /// 現在のミッションモード名（detumble / nadir / burn 等）。
    /// モード遷移を持たないコントローラは `none` を返す。
    /// **注意**: `run` が worker thread で store を占有するため、現状
    /// ホストからこの export を並行に呼ぶことはできない。将来対応予定。
    export current-mode: func() -> option<string>;

    /// ゲストのエントリーポイント。`init` + main loop を一つの関数で。
    /// ホストが `wait-tick` で中断させながら駆動する。
    export run: func(config: string) -> result<_, string>;
}
